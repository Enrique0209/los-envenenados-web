---
const direccion = 'Ignacio Allende 1013-1, Universidad, 50130 Toluca de Lerdo, Méx.';
const horario = 'Martes a sábado de 10:00 a 18:00 hrs';
const mapsQuery = encodeURIComponent(direccion);
---

<section class="location" id="ubicacion">
  <h2 class="location__title">Ubícanos</h2>

  <div class="location__info">
    <p class="location__address">{direccion}</p>
    <p class="location__hours">{horario}</p>
  </div>

  <div class="location__map">
    <iframe
      src={`https://www.google.com/maps?q=${mapsQuery}&output=embed`}
      width="100%"
      height="300"
      style="border:0;"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Ubicación de Los Envenenados en el mapa"
    ></iframe>
  </div>
</section>

<style>
  .location {

    padding: 2.5rem 1.25rem;
  }

  .location__title {
    color: #F5F5F0;
    font-size: 1.4rem;
    font-weight: bold;
    text-align: center;
    margin: 0 0 1.25rem;
  }

  .location__info {
    text-align: center;
    margin: 0 auto 1.5rem;
    max-width: 500px;
  }

  .location__address {
    color: #F5F5F0;
    font-size: 1rem;
    margin: 0 0 0.4rem;
  }

  .location__hours {
    color: #EA1C25;
    font-weight: bold;
    font-size: 1rem;
    margin: 0;
  }

  .location__map {
    max-width: 600px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
  }

  @media (min-width: 480px) {
    .location {
      padding: 4rem 1.5rem;
    }

    .location__title {
      font-size: 1.8rem;
      margin-bottom: 2rem;
    }
  }
</style>