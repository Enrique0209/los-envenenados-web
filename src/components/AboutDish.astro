---
const puntos = [
  {
    titulo: '¿Por qué "envenenado"?',
    texto: 'La historia se remonta a los años 40 en Zacatecas: un vendedor llamado Don Lauro anunciaba sus tacos con un letrero que decía "Si quiere envenenarse, coma tacos". El nombre se quedó — y se volvió tradición.',
  },
  {
    titulo: 'Origen zacatecano',
    texto: 'Tortilla grande, base de frijol, papa y chorizo, doblado como quesadilla y dorado en manteca. En Toluca casi no se encuentra — nosotros lo trajimos tal cual.',
  },
  {
    titulo: 'Una mordida basta',
    texto: 'Nuestro veneno de la casa lleva queso y la proteína que elijas, con papas y cebolla. Mismo espíritu zacatecano, receta de la casa.',
  },
];
---

<section class="about-dish" id="que-es">
  <h2 class="about-dish__title">¿Qué es un taco envenenado?</h2>

  <div class="about-dish__list">
    {puntos.map((punto) => (
      <article class="about-dish__item">
        <h3 class="about-dish__item-title">{punto.titulo}</h3>
        <p class="about-dish__item-text">{punto.texto}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .about-dish {
    padding: 2.5rem 1.25rem;
  }

  .about-dish__title {
    color: #F5F5F0;
    font-size: 1.4rem;
    font-weight: bold;
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .about-dish__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .about-dish__item {
    background-color: rgba(26, 26, 26, 1);
    border-radius: 8px;
    padding: 1rem;
  }

  .about-dish__item-title {
    color: #EA1C25;
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: normal;
    font-family: var(--font-body);
    margin: 0 0 0.4rem;
  }

  .about-dish__item-text {
    color: #F5F5F0;
    opacity: 0.85;
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.4;
  }

  @media (min-width: 480px) {
    .about-dish {
      padding: 4rem 1.5rem;
    }

    .about-dish__title {
      font-size: 1.8rem;
      margin-bottom: 2rem;
    }
  }
</style>