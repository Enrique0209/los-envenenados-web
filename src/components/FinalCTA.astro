---
// TODO: reemplazar con los links reales de cada plataforma cuando los tengas
// (mismos placeholders que en Navbar.astro y Hero.astro — actualizar los 3 lugares juntos)
const didiUrl = '#';
const uberUrl = '#';
const instagramUrl = 'https://instagram.com/losenvenenados_taqueria';
---

<section class="final-cta" id="pedir">
  <h2 class="final-cta__title">¿Ya se te antojó?</h2>
  <p class="final-cta__subtitle">Una mordida basta.</p>


  <a class="final-cta__instagram" href={instagramUrl} target="_blank" rel="noopener noreferrer">
    <i class="fa-brands fa-instagram" aria-hidden="true"></i>
    @losenvenenados_taqueria
  </a>
</section>

<style>
  .final-cta {

    padding: 2.5rem 1.25rem;
    text-align: center;
  }

  .final-cta__title {
    color: #F5F5F0;
    font-size: 1.5rem;
    font-weight: bold;
    margin: 0 0 0.4rem;
  }

  .final-cta__subtitle {
    color: #EA1C25;
    font-weight: bold;
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
  }

  .final-cta__buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 400px;
    margin: 0 auto 1.5rem;
  }

  .final-cta__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background-color: #EA1C25;
    color: #F5F5F0;
    font-weight: bold;
    text-decoration: none;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }

  .final-cta__instagram {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #F5F5F0;
    opacity: 0.85;
    text-decoration: none;
    font-size: 0.9rem;
  }

  @media (min-width: 480px) {
    .final-cta {
      padding: 4rem 1.5rem;
    }

    .final-cta__title {
      font-size: 2rem;
    }

    .final-cta__buttons {
      flex-direction: row;
      justify-content: center;
    }

    .final-cta__button {
      flex: 1;
    }
  }
</style>