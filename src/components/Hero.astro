<section class="hero">
  <div class="hero__content">
    <h1 class="hero__title">Tacos que no vas a olvidar</h1>
    <p class="hero__subtitle">Una mordida basta</p>

    <div class="hero__actions">
  <a href="https://www.didifood.com" target="_blank" rel="noopener noreferrer" class="hero__cta">
    Pedir por DiDi
  </a>
  <a href="https://www.ubereats.com" target="_blank" rel="noopener noreferrer" class="hero__cta">
    Pedir por Uber Eats
  </a>
  <a href="#ubicacion" class="hero__cta hero__cta--secondary">
    Ver ubicación
  </a>
</div>
  </div>
</section>

<style>
  .hero {
    background-color: #1a1a1a;
    padding: 3rem 1.25rem;
    text-align: center;
  }

  .hero__title {
    color: #F5F5F0;
    font-size: 1.8rem;
    font-weight: bold;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  .hero__subtitle {
    color: #EA1C25;
    font-size: 1.1rem;
    font-weight: bold;
    margin: 0 0 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero__cta {
    display: inline-block;
    background-color: #EA1C25;
    color: #F5F5F0;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    font-size: 1rem;
  }

  .hero__cta--secondary {
    background-color: transparent;
    border: 2px solid #F5F5F0;
    color: #F5F5F0;
  }

  @media (min-width: 480px) {
    .hero {
      padding: 5rem 1.5rem;
    }

    .hero__title {
      font-size: 2.5rem;
    }

    .hero__subtitle {
      font-size: 1.3rem;
    }

    .hero__actions {
      flex-direction: row;
      justify-content: center;
    }
  }
</style>