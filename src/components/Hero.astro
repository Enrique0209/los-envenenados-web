---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-taco.jpg';
---

<section class="hero">
  <Image
    src={heroImg}
    alt="Taco envenenado con papas, cebolla y chorizo, servido en Los Envenenados"
    class="hero__bg"
    widths={[400, 800, 1200]}
    sizes="100vw"
    quality={70}
  />
  <div class="hero__overlay"></div>

  <div class="hero__content">
    <h1 class="hero__title">Tacos que no vas a olvidar</h1>
    <p class="hero__subtitle">Una mordida basta</p>

    <div class="hero__actions">
      <a href="https://www.didifood.com" target="_blank" rel="noopener noreferrer" class="hero__cta">
        Pedir por DiDi
      </a>
      <a href="https://www.ubereats.com" target="_blank" rel="noopener noreferrer" class="hero__cta">
        Pedir por Uber Eats
      </a>
    </div>

    <a href="#ubicacion" class="hero__link">
      Ver ubicación
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 3rem 1.25rem;
    text-align: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(26, 26, 26, 0.78);
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
  }

  .hero__title {
    color: #F5F5F0;
    font-size: 1.8rem;
    font-weight: bold;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  .hero__subtitle {
    color: #EA1C25;
    font-size: 1.1rem;
    font-weight: bold;
    margin: 0 0 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 280px;
    margin: 0 auto;
  }

  .hero__cta {
    display: inline-block;
    background-color: #EA1C25;
    color: #F5F5F0;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .hero__link {
    display: inline-block;
    margin-top: 1rem;
    color: #F5F5F0;
    opacity: 0.85;
    font-size: 0.85rem;
    text-decoration: underline;
  }

  @media (min-width: 480px) {
    .hero {
      padding: 5rem 1.5rem;
    }

    .hero__title {
      font-size: 2.5rem;
    }

    .hero__subtitle {
      font-size: 1.3rem;
    }

    .hero__actions {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }
  }
</style>